{
  "Urls": "http://0.0.0.0:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "VideoFlow",
    "Audience": "VideoFlow",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "upload-route": {
        "ClusterId": "upload-cluster",
        "Match": {
          "Path": "/api/upload/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://localhost:5251/"
          }
        }
      },
      "upload-cluster": {
        "Destinations": {
          "upload": {
            "Address": "http://localhost:5009/"
          }
        }
      }
    }
  }
}
